#!/bin/sh
# Refuse to push a commit whose message says not to push it (ELI-694).
# Install once per clone: git config core.hooksPath scripts/hooks
remote="$1"
hooks_dir=$(dirname "$0")
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac   # branch delete
  # A remote tip missing from the local object store (someone else pushed
  # since the last fetch) cannot bound the range, so fall back to every
  # commit not on a known remote branch.
  case "$remote_sha" in
    *[!0]*) if git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
              range="$remote_sha..$local_sha"
            else
              range="$local_sha --not --remotes=$remote"
            fi ;;
    *) range="$local_sha --not --remotes=$remote" ;;
  esac
  # shellcheck disable=SC2086
  "$hooks_dir/check-no-push" $range || status=1
done
if [ "$status" -ne 0 ]; then
  echo "Push refused. Reword or drop the commit marked do not push, then push again." >&2
fi
exit "$status"
